Subject: [PATCH] [prices] Add Exploren and Wevolt; map 10 operators to
 Chargefox, Evie, Exploren, Wevolt

---
 networks.json | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/networks.json b/networks.json
index 0f31133..1b870e8 100644
--- a/networks.json
+++ b/networks.json
@@ -1,15 +1,17 @@
 {
   "schemaVersion": 1,
-  "updated": "2026-11-15",
+  "updated": "2026-11-19",
   "currency": "AUD",
   "other": {"fastPerKWh": 0.65, "slowPerKWh": 0.4, "source": "Typical Australian prices for a fast charger and an AC post on a network Charge Line doesn't list (Charge Line's charging price research, 27 October 2026)"},
   "networks": [
     {"id": "teslaSupercharger", "name": "Tesla Supercharger", "match": ["tesla"], "typicalPerKWh": 0.65, "teslaPerKWh": 0.55, "basis": "estimate", "siteReading": "blocked", "source": "Tesla prices each site by demand, shown in the Tesla app; a Supercharging Membership lowers the price for other EVs. tesla.com refuses automated readers.", "sourceUrl": "https://www.tesla.com/en_au/support/charging/supercharging", "checked": "2026-10-27"},
-    {"id": "evie", "name": "Evie", "match": ["evie"], "typicalPerKWh": 0.69, "basis": "estimate", "siteReading": "allowed", "source": "Evie: about $0.40 at a 50 kW highway site to $0.75 ultra-fast in Melbourne; an Open Charge Map listing checked September 2026 says $0.62 at night and $0.71 by day. The site's prices are in the Evie app only. robots.txt asks for 10 seconds between requests.", "sourceUrl": "https://evie.com.au/faq/how-much-does-it-cost-to-charge/", "checked": "2026-10-27"},
-    {"id": "chargefox", "name": "Chargefox", "match": ["chargefox"], "typicalPerKWh": 0.6, "basis": "published", "siteReading": "forbidden", "source": "Chargefox: site owners set the price; fast DC is 40–60c per kWh on average (Chargefox). Drivers report $0.60–0.74 at DC sites. Its terms forbid robots and scrapers.", "checked": "2026-10-27"},
+    {"id": "evie", "name": "Evie", "match": ["evie", "charging the regions"], "typicalPerKWh": 0.69, "basis": "estimate", "siteReading": "allowed", "source": "Evie: about $0.40 at a 50 kW highway site to $0.75 ultra-fast in Melbourne; an Open Charge Map listing checked September 2026 says $0.62 at night and $0.71 by day. The site's prices are in the Evie app only. robots.txt asks for 10 seconds between requests.", "sourceUrl": "https://evie.com.au/faq/how-much-does-it-cost-to-charge/", "checked": "2026-10-27"},
+    {"id": "chargefox", "name": "Chargefox", "match": ["chargefox", "yurika", "queensland electric super highway", "raa", "electric highway tasmania", "wa ev network", "horizon power", "woolworths"], "typicalPerKWh": 0.6, "basis": "published", "siteReading": "forbidden", "source": "Chargefox: site owners set the price; fast DC is 40–60c per kWh on average (Chargefox). Drivers report $0.60–0.74 at DC sites. Its terms forbid robots and scrapers.", "checked": "2026-10-27"},
     {"id": "ampolAmpCharge", "name": "Ampol AmpCharge", "match": ["ampcharge", "ampol"], "typicalPerKWh": 0.69, "basis": "estimate", "siteReading": "unchecked", "source": "Ampol: prices vary by location, shown in the Ampol app; Open Charge Map listings say $0.60–0.75.", "sourceUrl": "https://ampcharge.ampol.com.au/policies/ampolcard-with-ev-charging-terms-and-conditions", "checked": "2026-10-27"},
     {"id": "bpPulse", "name": "BP Pulse", "match": ["bp pulse", "bppulse"], "typicalPerKWh": 0.65, "basis": "estimate", "siteReading": "blocked", "source": "bp pulse: pricing may vary between locations, some with peak and off-peak prices (bp pulse FAQs). bp's site refuses automated readers.", "sourceUrl": "https://www.bp.com/en_au/australia/home/products-services/bppulse/faqs.html", "checked": "2026-10-27"},
     {"id": "nrma", "name": "NRMA", "match": ["nrma"], "typicalPerKWh": 0.79, "basis": "published", "siteReading": "allowed", "source": "NRMA: priced by location, $0.69–0.99 a kWh in the My NRMA app, members 5c less. Its public table of site prices may be read but not copied into an app without NRMA's permission.", "sourceUrl": "https://www.mynrma.com.au/electric-vehicles/charging", "checked": "2026-10-27"},
-    {"id": "jolt", "name": "Jolt", "match": ["jolt"], "typicalPerKWh": 0.45, "freeKWhPerDay": 7, "basis": "estimate", "siteReading": "forbidden", "source": "Jolt: 7 kWh free a day at fast chargers, then paid; Open Charge Map listings say $0.40–0.46 after the free 7 kWh. Its terms forbid scraping.", "sourceUrl": "https://jolt.com.au/fair-use-policy", "checked": "2026-10-27"}
+    {"id": "jolt", "name": "Jolt", "match": ["jolt"], "typicalPerKWh": 0.45, "freeKWhPerDay": 7, "basis": "estimate", "siteReading": "forbidden", "source": "Jolt: 7 kWh free a day at fast chargers, then paid; Open Charge Map listings say $0.40–0.46 after the free 7 kWh. Its terms forbid scraping.", "sourceUrl": "https://jolt.com.au/fair-use-policy", "checked": "2026-10-27"},
+    {"id": "exploren", "name": "Exploren", "match": ["exploren", "engie"], "typicalPerKWh": null, "basis": "none", "siteReading": "forbidden", "source": "Exploren (EVSE, Intellihub Group): drivers pay in the Exploren app; site owners set prices. EVSE bought ENGIE's Australian fast-charging network in April 2025 and moved it into Exploren (The Driven, 8 April 2025). No source we may read states a typical price. Its terms forbid automated reading.", "sourceUrl": "https://thedriven.io/2025/04/08/evse-acquires-engies-australian-and-new-zealand-ev-charging-network/", "checked": "2026-11-19"},
+    {"id": "wevolt", "name": "Wevolt", "match": ["wevolt", "electrona"], "typicalPerKWh": null, "basis": "none", "siteReading": "unchecked", "source": "Wevolt: drivers pay in the Wevolt app; independent operators set their own prices, plus a Wevolt service fee (wevolt.com.au/drivers). Electrona's Tasmanian chargers take the Wevolt app or a card. No published typical price. robots.txt blocks AI training crawlers but allows answer agents; terms not checked.", "sourceUrl": "https://wevolt.com.au/drivers", "checked": "2026-11-19"}
   ]
 }
