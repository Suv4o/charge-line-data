---
 networks.json | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/networks.json b/networks.json
index 0f31133..8703913 100644
--- a/networks.json
+++ b/networks.json
@@ -1,15 +1,17 @@
 {
   "schemaVersion": 1,
