path"]}],"properties":{"body":{"description":"Artifact content, limited by max-issue-artifact-size in UTF-8 bytes (default: 1048576).","minLength":1,"pattern":".*\\S.*","type":"string"},"name":{"minLength":1,"pattern":".*\\S.*","type":"string"},"path":{"description":"Absolute literal path to a non-empty UTF-8 text file within the workspace or /tmp/gh-aw/agent (e.g., /tmp/gh-aw/agent/plan.md). Repository .git metadata, system directories, and HOME credential/config paths are denied. The MCP backend reads it into body before recording the request. Variables and globs are not expanded. Links and non-regular files are rejected; max-issue-artifact-size bounds the read (default: 1mb). Do not also provide body.","minLength":1,"pattern":"^/","type":"string"},"type":{"default":"generic","enum":["generic","link","plan","embedded_html"],"type":"string"}},"required":["name"],"type":"object"},"type":"array"},"blocked_by":{"description":"Issue dependencies that block this issue. Provide one issue number, temporary_id, owner/repo#number reference, GitHub issue URL, or an array of these references. Temporary IDs are resolved before the dependency is created.","items":{"type":["number","string"]},"type":["number","string","array"]},"body":{"description":"Detailed issue description in Markdown. Must be the final intended body — not a placeholder or test value. Do NOT repeat the title as a heading since it already appears as the issue's h1. Include context, reproduction steps, or acceptance criteria as appropriate.","maxLength":524288,"minLength":20,"type":"string"},"depends-on":{"description":"One output_id, or a nonempty array of output_id values returned by earlier safe-output calls. Execute only after every prerequisite succeeds; otherwise this output fails. These are not temporary resource IDs. Do not use ledger output IDs as prerequisites: ledger writes are queued until the later persistence job. Submit related ledger operations sequentially without depends-on; use temporary rec