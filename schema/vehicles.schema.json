{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Suv4o/charge-line-data/schema/vehicles.schema.json",
  "title": "Charge Line vehicle catalogue",
  "description": "Electric vehicles sold new in Australia, with the figures Charge Line's trip planner needs. Property order is the canonical order in vehicles.json.",
  "type": "object",
  "required": ["schemaVersion", "updated", "vehicles"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "format": "date", "description": "The day the data last changed (YYYY-MM-DD)." },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "description": "Tesla and BYD first, then makes A to Z; one make's cars together.",
      "items": {
        "type": "object",
        "required": ["id", "make", "model", "variant", "year", "body", "usableKWh", "wltpKm", "maxDCkW", "maxACkW", "connectors", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Never renamed or removed: drivers' saved cars point to it." },
          "make": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "description": "Empty when the model has one version." },
          "year": { "type": "integer", "minimum": 2010, "maximum": 2100, "description": "First model year these figures are for." },
          "untilYear": { "type": "integer", "minimum": 2010, "maximum": 2100, "description": "Last model year, once the car is no longer sold new." },
          "body": { "enum": ["car", "suv", "van", "ute"] },
          "usableKWh": { "type": "number", "minimum": 15, "maximum": 250 },
          "wltpKm": { "type": "integer", "minimum": 100, "maximum": 1200 },
          "maxDCkW": { "type": "integer", "minimum": 20, "maximum": 1000 },
          "maxACkW": { "type": "number", "minimum": 3, "maximum": 22 },
          "connectors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["ccs2", "type2", "chademo"] }
          },
          "charge": {
            "description": "The maker's fast-charge claim: from % to % in minutes, or Tesla's km added in 15 minutes.",
            "oneOf": [
              {
                "type": "object",
                "required": ["from", "to", "minutes"],
                "additionalProperties": false,
                "properties": {
                  "from": { "type": "integer", "minimum": 0, "maximum": 99 },
                  "to": { "type": "integer", "minimum": 1, "maximum": 100 },
                  "minutes": { "type": "number", "minimum": 5, "maximum": 180 }
                }
              },
              {
                "type": "object",
                "required": ["kmIn15Minutes"],
                "additionalProperties": false,
                "properties": {
                  "kmIn15Minutes": { "type": "integer", "minimum": 50, "maximum": 600 }
                }
              }
            ]
          },
          "epa": {
            "type": "object",
            "description": "US EPA Test Car List target coefficients (lbf, lbf/mph, lbf/mph²) and equivalent test weight (lb).",
            "required": ["a", "b", "c", "testWeightLb"],
            "additionalProperties": false,
            "properties": {
              "a": { "type": "number", "minimum": 0, "maximum": 200 },
              "b": { "type": "number", "minimum": -5, "maximum": 5 },
              "c": { "type": "number", "minimum": 0, "maximum": 0.1 },
              "testWeightLb": { "type": "number", "minimum": 2000, "maximum": 10000 }
            }
          },
          "kerbKg": { "type": "integer", "minimum": 800, "maximum": 4000 },
          "highwayWhPerKm": { "type": "number", "minimum": 100, "maximum": 450 },
          "checked": { "type": "string", "format": "date", "description": "The day someone last checked this entry against a source." },
          "source": { "type": "string", "minLength": 10, "description": "Where the figures come from; \"est.\" marks numbers the maker doesn't publish." }
        }
      }
    }
  }
}
